{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeai/answer_v1",
  "title": "ForgeAI agent answer, version 1",
  "type": "object",
  "required": ["status", "answer", "citations", "tool_calls", "clarifying_question"],
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["answered", "refused", "needs_clarification"]},
    "answer": {"type": "string"},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc", "chunk_id", "quote"],
        "additionalProperties": false,
        "properties": {
          "doc": {"type": "string"},
          "chunk_id": {"type": "string"},
          "quote": {"type": "string", "description": "Verbatim span copied from the cited chunk"}
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "args", "result"],
        "additionalProperties": false,
        "properties": {
          "tool": {"type": "string"},
          "args": {"type": "object"},
          "result": {"type": "string"}
        }
      }
    },
    "clarifying_question": {"type": ["string", "null"]}
  }
}
